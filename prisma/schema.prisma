generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tournament {
  id          String   @id @default(cuid())
  name        String
  description String?
  type        String
  status      String   @default("draft")
  startDate   DateTime?
  endDate     DateTime?
  maxPlayers  Int?
  ownerId     String?
  owner       User?    @relation("UserTournaments", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  players     Player[]
  matches     Match[]
  groups      Group[]
}

model Player {
  id           String      @id @default(cuid())
  name         String
  email        String?
  phone        String?
  seed         Int?
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group        Group?      @relation(fields: [groupId], references: [id])
  groupId      String?
  createdAt    DateTime    @default(now())

  matches      MatchPlayer[]

  @@index([tournamentId])
}

model Group {
  id           String   @id @default(cuid())
  name         String
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  players      Player[]

  @@unique([tournamentId, name])
}

model Match {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  round        Int
  matchNumber  Int
  stage        String   @default("main")

  player1Id    String?
  player2Id    String?
  player1      MatchPlayer? @relation("MatchPlayer1Match", fields: [player1Id], references: [id])
  player2      MatchPlayer? @relation("MatchPlayer2Match", fields: [player2Id], references: [id])
  
  winnerId     String?
  winnerScore  Int?
  loserScore   Int?
  bestOf       Int      @default(5)
  
  table        String?
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  status       String   @default("pending")

  gameScores   GameScore[]
  matchPlayers MatchPlayer[]

  @@unique([tournamentId, round, matchNumber, stage])
  @@index([tournamentId, status])
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player  @relation(fields: [playerId], references: [id])

  position  Int
  isWinner  Boolean @default(false)

  player1Matches Match[] @relation("MatchPlayer1Match")
  player2Matches Match[] @relation("MatchPlayer2Match")

  @@unique([matchId, position])
  @@index([matchId])
  @@index([playerId])
}

model GameScore {
  id        String @id @default(cuid())
  matchId   String
  match     Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  gameNumber Int
  player1Score Int
  player2Score Int

  @@unique([matchId, gameNumber])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  tournaments   Tournament[] @relation("UserTournaments")
  bookmarks     VideoBookmark[]
  trainingPlans TrainingPlan[]
  watchHistory  VideoWatchHistory[]
  goals         Goal[]
  milestones    Milestone[]
  feedbacks     Feedback[]
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String?
  category     String
  skillLevel   String
  duration     Int?
  storagePath  String
  thumbnailUrl String?
  published    Boolean  @default(false)
  coachId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tags          VideoTag[]
  bookmarks     VideoBookmark[]
  trainingItems TrainingPlanItem[] @relation("TrainingPlanItemVideo")
  watchHistory  VideoWatchHistory[] @relation("VideoWatchHistoryVideo")

  @@index([published, skillLevel])
  @@index([published, category])
  @@index([published, createdAt(sort: Desc)])
}

model VideoTag {
  id     String  @id @default(cuid())
  name   String  @unique
  videos Video[]
}

model VideoBookmark {
  id           String   @id @default(cuid())
  userId       String
  videoId      String
  bookmarkedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId, bookmarkedAt(sort: Desc)])
  @@index([videoId])
}

model TrainingPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  TrainingPlanItem[]

  @@index([userId, createdAt(sort: Desc)])
}

model TrainingPlanItem {
  id           String   @id @default(cuid())
  planId       String
  videoId      String?
  title        String
  description  String?
  sortOrder    Int      @default(0)
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  plan   TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  video  Video?       @relation("TrainingPlanItemVideo", fields: [videoId], references: [id], onDelete: SetNull)

  @@index([planId, sortOrder])
}

model VideoWatchHistory {
  id          String   @id @default(cuid())
  userId      String
  videoId     String
  watchedAt   DateTime @default(now())
  durationSec Int?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation("VideoWatchHistoryVideo", fields: [videoId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt(sort: Desc)])
  @@index([videoId])
  @@index([userId, videoId])
}

model Goal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  target      String?
  deadline    DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completed, createdAt(sort: Desc)])
  @@index([userId, deadline])
}

model Milestone {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  achievedAt  DateTime @default(now())
  type        String
  metadata    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, achievedAt(sort: Desc)])
  @@index([type])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  subject   String
  message   String?
  type      String   @default("general")
  status    String   @default("new")
  response  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([userId])
}
